{
  "name": "@flare-kit/react",
  "version": "0.1.0",
  "description": "React provider and hooks over the Flare operation lifecycle. Works against a live kit or the mock, unchanged.",
  "license": "MIT",
  "engines": {
    "node": ">=21"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@flare-kit/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
