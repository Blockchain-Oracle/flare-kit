{
  "name": "@flare-kit/contracts",
  "version": "0.1.0",
  "description": "Typed ABIs and the single address registry for Flare networks. Every address in flare-kit comes from here.",
  "keywords": [
    "flare",
    "coston2",
    "fassets",
    "fxrp",
    "ftso",
    "fdc",
    "abi",
    "address-registry",
    "viem",
    "web3"
  ],
  "homepage": "https://flare-kit.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blockchain-Oracle/flare-kit.git",
    "directory": "packages/contracts"
  },
  "bugs": {
    "url": "https://github.com/Blockchain-Oracle/flare-kit/issues"
  },
  "license": "MIT",
  "author": "Abubakr Jimoh",
  "engines": {
    "node": ">=20.11"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "viem": "^2.40.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
