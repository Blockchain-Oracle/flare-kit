{
  "name": "@flare-kit/react-ui",
  "version": "0.1.0",
  "description": "Styled, embeddable Flare widgets: MintFXRP, OperationTimeline, ConnectButton. Hand-written CSS on the DESIGN.md tokens.",
  "keywords": [
    "flare",
    "react",
    "components",
    "widgets",
    "fassets",
    "fxrp",
    "swap",
    "bridge",
    "ui",
    "web3"
  ],
  "homepage": "https://flare-kit.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blockchain-Oracle/flare-kit.git",
    "directory": "packages/react-ui"
  },
  "bugs": {
    "url": "https://github.com/Blockchain-Oracle/flare-kit/issues"
  },
  "license": "MIT",
  "author": "Abubakr Jimoh",
  "engines": {
    "node": ">=21"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint",
    "clean": "rm -rf dist .turbo",
    "gallery": "vite --config gallery/vite.config.ts"
  },
  "dependencies": {
    "@flare-kit/core": "workspace:^"
  },
  "peerDependencies": {
    "@flare-kit/react": "workspace:^",
    "react": "^18.3.0 || ^19.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@flare-kit/react": "workspace:^",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.12.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
