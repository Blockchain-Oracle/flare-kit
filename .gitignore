# Vendored reference clones — protocol source read during research, never ours.
# No trailing slash: a linked worktree reaches these through a SYMLINK, and git
# treats a symlink as a file, so a directory-only pattern would not match it.
sources
developer-hub

.playwright-mcp/

# Agent-harness tooling, not project source. None of it describes how the
# product works, so none of it belongs in a public repository.
.claude/
.agents/
.superpowers/
.harness.json

# The engineering record: specs, decisions, research, plans, handoffs and
# design commissions. It is how this project was built rather than what was
# built, it is written agent-to-agent, and it stays local (Abu, 2026-08-15).
.thoughts/
SPEC.md

# Vendored reference material read during research, never ours. reference/ is a
# Hardhat project holding upstream protocol contracts; uniswap/ holds recut
# source and brand marks pulled in for the M5 direction study.
reference/
uniswap/

# Loose console capture from the M1 live run.
m1-console.txt

# Linked worktrees live inside the project root and must never be committed
# back into it.
.worktrees/

# Signing keys for a live testnet run. Never committed.
.secrets/

# fumadocs-mdx generated content layer, rewritten on every build.
.source/

# Pagefind static index, emitted by the post-build step.
apps/site/public/pagefind/

# npm auth lives in ~/.npmrc, never in the repo
.npmrc
